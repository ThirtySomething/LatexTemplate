\NeedsTeXFormat{LaTeX2e}[2021/06/01]
\ProvidesPackage{tscommands}[2026/11/05 v1.0.0 Beginner-friendly LaTeX commands]

\RequirePackage{babel}
\RequirePackage{graphicx}
\RequirePackage{fancyvrb}
\RequirePackage{float}
\RequirePackage{datetime}
\RequirePackage{ifthen}
\@ifpackageloaded{ulem}{}{\RequirePackage[normalem]{ulem}}
\RequirePackage{enumitem}
\@ifpackageloaded{overpic}{}{\RequirePackage[percent]{overpic}}
\RequirePackage{nicefrac}
\@ifpackageloaded{wasysym}{}{\RequirePackage[nointegrals]{wasysym}}
\RequirePackage{xcolor}
\@ifpackageloaded{contour}{}{\RequirePackage[outline]{contour}}

\newdateformat{tscommands@dategerman}{\twodigit{\THEDAY}.\twodigit{\THEMONTH}.\THEYEAR}
\newdateformat{tscommands@dateamerican}{\twodigit{\THEMONTH}/\twodigit{\THEDAY}/\THEYEAR}

\newcommand{\tscommands@label}[3]%
{%
    \ifthenelse{\equal{#2}{}}%
        {\label{#1:#3}}%
        {\label{#1:#2}}%
}
\newcommand{\tsAppendixIncludeFile}[2][]%
{%
    \tsAppendixSection[#1]{#2}%
    \VerbatimInput[fontsize=\scriptsize]{#2}%
}
\newcommand{\tsAppendixSection}[2][]%
{%
    \newpage%
    \section{#2}\tscommands@label{appendix}{#1}{#2}%
}
\newcommand{\tsArrowRight}{\ensuremath{\rightarrow}}
\newcommand{\tsArrowDown}{\ensuremath{\downarrow}}
\newcommand{\tsArrowLeft}{\ensuremath{\leftarrow}}
\newcommand{\tsArrowUp}{\ensuremath{\uparrow}}
\newcommand{\tsArrowRightDouble}{\ensuremath{\Rightarrow}}
\newcommand{\tsArrowDownDouble}{\ensuremath{\Downarrow}}
\newcommand{\tsArrowLeftDouble}{\ensuremath{\Leftarrow}}
\newcommand{\tsArrowUpDouble}{\ensuremath{\Uparrow}}
\newcommand{\tsBackslash}{\textbackslash}
\newcommand{\tsBullet}{\textbullet{}}
\NewExpandableDocumentCommand{\tsCaptionLabelFigure}{O{} m}
    {\caption{#2}\tscommands@label{fig}{#1}{#2}}
\newcommand{\tsCaptionLabelFormula}[2][]%
{%
    \begin{equation}%
        #2%
        \tscommands@label{for}{#1}{\theequation}%
    \end{equation}%
}
\NewExpandableDocumentCommand{\tsCaptionLabelTable}{O{} m}
    {\caption{#2}\tscommands@label{tab}{#1}{#2}}
\newcommand{\tsCitation}[1]{~\cite{#1}}
\newcommand{\tsDegree}[1]{#1\ensuremath{{}^\circ}}
\newcommand{\tsDiameter}{\diameter}
\newcommand{\tsFrac}[2]{\nicefrac{#1}{#2}}
\newcommand{\tsFootnoteDef}[2]{\footnote{\label{#2}#1}}
\newcommand{\tsFootnoteRef}[1]{\tsTextUpper{\ref{#1}}}
\NewDocumentCommand{\tsImage}{O{} O{H} m m m}%
{%
    \begin{figure}[#2]%
        \centering%
        \includegraphics[#5]{#3}%
        \tsCaptionLabelFigure[#1]{#4}%
    \end{figure}%
}
\NewDocumentCommand{\tsImageF}{O{} O{H} m m m}%
{%
    \begin{figure}[#2]%
        \centering%
        \fbox{\includegraphics[#5]{#3}}%
        \tsCaptionLabelFigure[#1]{#4}%
    \end{figure}%
}
\NewDocumentCommand{\tsImageO}{O{} O{H} m m m m}%
{%
    \begin{figure}[#2]%
        \centering%
        \begin{overpic}[permil,#6]{#3}%
            \put(10,10){\textcolor{white}{\scriptsize\contour{black}{#5}}}%
        \end{overpic}%
        \tsCaptionLabelFigure[#1]{#4}%
    \end{figure}%
}
\NewDocumentCommand{\tsImageOF}{O{} O{H} m m m m}%
{%
    \begin{figure}[#2]%
        \centering%
        \fbox{%
            \begin{overpic}[permil,#6]{#3}%
                \put(10,10){\textcolor{white}{\scriptsize\contour{black}{#5}}}%
            \end{overpic}%
        }%
        \tsCaptionLabelFigure[#1]{#4}%
    \end{figure}%
}
\newcommand{\tsNP}{\bigbreak}
\newcommand{\tsTextBold}[1]{\textbf{#1}}
\newcommand{\tsTextItalic}[1]{\textit{#1}}
\newcommand{\tsTextLower}[1]{\textsubscript{#1}}
\newcommand{\tsTextMonospace}[1]{\texttt{#1}}
\newcommand{\tsTextQuoteF}[1]{\guillemotleft{}#1\guillemotright{}}
\newcommand{\tsTextQuoteG}[1]{\glqq{}#1\grqq{}}
\newcommand{\tsTextStrikethrough}[1]{\sout{#1}}
\newcommand{\tsTextUnderline}[1]{\underline{#1}}
\newcommand{\tsTextUpper}[1]{\textsuperscript{#1}}
\newcommand{\tsToday}%
{%
    {%
        \ifdefined\tsDocumentLanguage%
            \edef\tscommands@datelanguage{\tsDocumentLanguage}%
        \else%
            \edef\tscommands@datelanguage{\languagename}%
            \ifthenelse{\equal{\tscommands@datelanguage}{\detokenize{english}}}%
                {\def\tscommands@datelanguage{american}}%
                {}%
        \fi%
        \edef\tscommands@datelanguage{%
            \expandafter\detokenize\expandafter{\tscommands@datelanguage}}%
        \ifthenelse{\equal{\tscommands@datelanguage}{\detokenize{american}}}%
            {\tscommands@dateamerican}%
            {\tscommands@dategerman}%
        \formatdate{\day}{\month}{\year}%
    }%
}
